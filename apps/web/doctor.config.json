{
  "$schema": "https://react.doctor/schema/config.json",
  // Rationale for every suppression lives in docs/lint-policy.md (repo root).
  "ignore": {
    "rules": [
      // Deliberate architecture choice: the hero float/fade animations use the
      // built-in RN Animated API instead of react-native-reanimated. Adding
      // reanimated would grow the web bundle substantially for two decorative
      // loops, working against the Lighthouse performance budget.
      "react-doctor/rn-prefer-reanimated"
    ],
    "overrides": [
      {
        // `TopNavFull` is exported-but-unused while the landing page is a
        // placeholder. It is the full reference top nav, kept for the real
        // landing page and the product screens.
        "files": ["src/components/top-nav.tsx"],
        "rules": ["deslop/unused-export"]
      },
      {
        // The legal pages (terms/privacy) render all sections eagerly inside a
        // ScrollView on purpose: the static export must contain the full text
        // for SEO, and the TOC measures every section's offset for scroll
        // tracking. A virtualized FlatList would drop offscreen sections from
        // the HTML and break both.
        "files": ["src/components/legal-screen.tsx"],
        "rules": ["react-doctor/rn-no-scrollview-mapped-list"]
      }
    ]
  }
}
