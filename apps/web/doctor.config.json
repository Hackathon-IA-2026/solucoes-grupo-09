{
  "$schema": "https://react.doctor/schema/config.json",
  // Rationale for every suppression lives in docs/lint-policy.md (repo root).
  "ignore": {
    "rules": [
      // Deliberate architecture choice: the hero float/fade animations use the
      // built-in RN Animated API instead of react-native-reanimated. Adding
      // reanimated would grow the web bundle substantially for two decorative
      // loops, working against the Lighthouse performance budget.
      "react-doctor/rn-prefer-reanimated",
      // False positive: the only match is `String.prototype.includes(q)`
      // (substring search in the reviews filter). The rule treats it as an
      // array-membership lookup, but a Set can't do substring matching.
      "react-doctor/js-set-map-lookups"
    ],
    "overrides": [
      {
        // `TopNavFull` is intentionally exported-but-unused: the full
        // reference top nav is preserved (per product decision) for when the
        // dashboard grows real sections. See the component's doc comment.
        "files": ["src/components/top-nav.tsx"],
        "rules": ["deslop/unused-export"]
      },
      {
        // Two false positives in the reviews feed:
        // - js-set-map-lookups flags `String.prototype.includes(q)` (substring
        //   search in the filter) as an array membership lookup; a Set cannot
        //   replace substring matching.
        // - no-impure-state-updater flags the `onChangeText` event handler
        //   (two plain sequential setters) as a state-updater callback with
        //   side effects; it is a normal event handler, not an updater fn.
        "files": ["src/components/reviews-feed.tsx"],
        "rules": ["react-doctor/no-impure-state-updater"]
      }
    ]
  }
}
