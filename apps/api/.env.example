# Copy to .env and adjust. Bun auto-loads .env (no dotenv needed).

# --- HTTP API ---
# Port the Elysia API listens on (PaaS like Railway inject this).
PORT=3000
# Set to "production" to enable HSTS and lock CORS to ZALYTIX_CORS_ORIGINS.
NODE_ENV=development
# Optional: public base URL pinned in the OpenAPI `servers` (e.g. your deploy
# URL). Leave empty to use the origin Swagger UI was loaded from.
ZALYTIX_PUBLIC_URL=http://localhost:3000
# Browser origins allowed by CORS in production, comma-separated. The deployed
# web app's origin MUST be listed or its API calls fail preflight. Ignored in
# development (all origins allowed there).
ZALYTIX_CORS_ORIGINS=https://zalytix.com,https://www.zalytix.com

# --- Scraper defaults (applied when a request/CLI flag omits them) ---
# Upstream proxy for stealth, e.g. http://user:pass@host:8080 or socks5://...
ZALYTIX_PROXY=
# Match the browser's timezone/locale to the proxy exit IP (1/true to enable).
ZALYTIX_GEOIP=false
# Default stealth preset: max | balanced | fast
ZALYTIX_STEALTH=max

# --- Resilience / resource control (API) ---
# Max scrapes running at once (each launches a Chromium). Tune to host RAM.
ZALYTIX_MAX_CONCURRENCY=2
# Max scrapes allowed to queue before returning 503.
ZALYTIX_MAX_QUEUE=20
# Hard time budget per scrape (ms); partial results returned, else 504.
ZALYTIX_SCRAPE_TIMEOUT_MS=120000
# Page-navigation timeout (ms).
ZALYTIX_NAV_TIMEOUT_MS=60000
# Per in-page fetch timeout (ms) — bounds a stalled network.
ZALYTIX_FETCH_TIMEOUT_MS=30000
# Bounded retries on transient navigation/network failures.
ZALYTIX_NAV_RETRIES=2

# --- Async jobs (optional) ---
# Redis URL. When set, scrape jobs run on a durable BullMQ queue (async job API
# + multi-worker + restart-safe). Unset → in-process runner (simple/dev).
REDIS_URL=
# Process role: all (API + embedded worker) | api (enqueue only) | worker.
# Use api + separate `bun run worker` processes to scale scraping independently.
ZALYTIX_ROLE=all
# Auto-remove finished jobs from Redis after this many seconds (results stay
# poll-able until then). Completed kept 1h, failed 24h by default.
ZALYTIX_JOB_RETENTION_SEC=3600
ZALYTIX_JOB_FAILED_RETENTION_SEC=86400
# Retry failed jobs (scrapes are idempotent/read-only, so retries are safe).
ZALYTIX_JOB_ATTEMPTS=3
ZALYTIX_JOB_BACKOFF_MS=5000
# Mount the BullMQ Workbench dashboard at /jobs (requires REDIS_URL). Exposes
# queue data/controls — enable only behind your own auth/network protection.
ZALYTIX_DASHBOARD=false

# --- Database (optional) ---
# Postgres URL. When set, scraped reviews are persisted (durable, deduped) and
# queryable via GET /reviews/stored. Run `bun run db:migrate` first. Unset →
# scraping still works, results are just transient.
DATABASE_URL=