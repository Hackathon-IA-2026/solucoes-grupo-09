# Copy to .env and adjust. Bun auto-loads .env (no dotenv needed).

# --- HTTP API ---
# Port the Elysia API listens on (PaaS like Railway inject this).
PORT=3000
# Set to "production" to enable HSTS and lock CORS to WATTSTEER_CORS_ORIGINS.
NODE_ENV=development
# Optional: public base URL pinned in the OpenAPI `servers` (e.g. your deploy
# URL). Leave empty to use the origin Swagger UI was loaded from.
WATTSTEER_PUBLIC_URL=http://localhost:3000
# Browser origins allowed by CORS in production, comma-separated. The deployed
# web app's origin MUST be listed or its API calls fail preflight. Ignored in
# development (all origins allowed there).
WATTSTEER_CORS_ORIGINS=https://wattsteer.com,https://www.wattsteer.com

# --- Rate limiting ---
# Per-client requests allowed per window on the metered surface. 0 disables.
WATTSTEER_RATE_LIMIT=60
WATTSTEER_RATE_WINDOW_MS=60000

# --- Background jobs (optional) ---
# Redis URL. When set, jobs run on a durable BullMQ queue (multi-worker,
# restart-safe). Unset → in-process runner (simple/dev).
REDIS_URL=
# Process role: all (API + embedded worker) | api (enqueue only) | worker.
# Use api + separate `bun run worker` processes to scale work independently.
WATTSTEER_ROLE=all
# Jobs processed simultaneously per worker.
WATTSTEER_JOB_CONCURRENCY=2
# Auto-remove finished jobs from Redis after this many seconds (results stay
# poll-able until then). Completed kept 1h, failed 24h by default.
WATTSTEER_JOB_RETENTION_SEC=3600
WATTSTEER_JOB_FAILED_RETENTION_SEC=86400
# Retry failed jobs. Handlers are expected to be idempotent.
WATTSTEER_JOB_ATTEMPTS=3
WATTSTEER_JOB_BACKOFF_MS=5000
# Mount the BullMQ Workbench dashboard at /jobs (requires REDIS_URL). Exposes
# queue data/controls — enable only behind your own auth/network protection.
WATTSTEER_DASHBOARD=false

# --- Database ---
# Postgres URL. Unset → persistence disabled and /ready reports ready.
DATABASE_URL=

# --- Tests ---
# Set by `bun run test:redis` to point the BullMQ suite at a throwaway Redis.
WATTSTEER_TEST_REDIS_URL=
# Set by `bun run test:db` to point the bitemporal as-of suite at a throwaway
# Postgres. Unset → that suite skips, so the default `bun test` needs no server.
WATTSTEER_TEST_DATABASE_URL=

# --- ingestion: refresh, custody, retention ---
# Register the three repeatable refresh sweeps on the worker (live/recent/history).
# WATTSTEER_REFRESH=off

# Raw-payload custody. Production is an S3-compatible bucket; a Railway bucket
# injects BUCKET / ACCESS_KEY_ID / SECRET_ACCESS_KEY / ENDPOINT / REGION, which
# are read as fallbacks, so these are only needed to override them.
# WATTSTEER_ARCHIVE_BUCKET=wattsteer-raw-abc123
# WATTSTEER_ARCHIVE_ACCESS_KEY_ID=...
# WATTSTEER_ARCHIVE_SECRET_ACCESS_KEY=...
# WATTSTEER_ARCHIVE_ENDPOINT=https://storage.railway.app
# WATTSTEER_ARCHIVE_REGION=auto
# Directory archive, for local development when there is no bucket.
# WATTSTEER_ARCHIVE_DIR=./.archive
# Days a payload that produced no revision is kept (productive ones are kept
# indefinitely).
# WATTSTEER_ARCHIVE_RETENTION_DAYS=90
