{
  "name": "wattsteer-api",
  "version": "0.1.0",
  "description": "WattSteer API — ingestion, gateway and public HTTP surface.",
  "type": "module",
  "scripts": {
    "api": "bun run src/api/index.ts",
    "api:dev": "bun run --watch src/api/index.ts",
    "worker": "bun run src/worker.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "bunx biome check",
    "test": "REDIS_URL= DATABASE_URL= bun test test/errors.test.ts test/job.test.ts test/rate-limit.test.ts test/ons-energy-balance.test.ts test/api.test.ts",
    "test:redis": "WATTSTEER_TEST_REDIS_URL=redis://localhost:6390 REDIS_URL= DATABASE_URL= bun test test/bullmq.test.ts",
    "test:db": "DATABASE_URL=postgres://postgres:wattsteer@localhost:5434/wattsteer bun run db:push && WATTSTEER_TEST_DATABASE_URL=postgres://postgres:wattsteer@localhost:5434/wattsteer DATABASE_URL= REDIS_URL= bun test test/database.test.ts",
    "docker:build": "docker build -f Dockerfile -t wattsteer-api:latest ../..",
    "docker:run": "docker run --rm -p 3000:3000 wattsteer-api:latest",
    "docker:up": "docker compose -f ../../docker-compose.yml up --build"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@sinclair/typebox": "0.34.49"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/server-timing": "^1.4.1",
    "@elysiajs/swagger": "^1.3.1",
    "@getworkbench/elysia": "^0.9.1",
    "@sinclair/typebox": "0.34.49",
    "bullmq": "^5.78.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "hyparquet": "^1.29.2",
    "hyparquet-compressors": "^1.1.1",
    "ioredis": "5.10.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@elysiajs/eden": "^1.4.9",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
