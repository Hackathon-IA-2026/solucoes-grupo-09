{
  "name": "@wattsteer/core",
  "version": "0.1.0",
  "private": true,
  "description": "WattSteer's shared domain: the vocabulary, the published constants and the cross-language golden vectors. Pure TypeScript, no UI dependencies.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./constants": "./src/constants.ts",
    "./domain": "./src/domain.ts",
    "./api": "./src/types.generated.ts",
    "./wire": "./src/wire.ts",
    "./client": "./src/client.ts",
    "./scenario": "./src/scenario.ts",
    "./schema": "./src/schema.ts",
    "./schema/*": "./schema/*"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:types": "bun run scripts/generate-types.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.0"
  }
}
