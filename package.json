{
  "name": "noviq",
  "version": "0.1.0",
  "description": "Humanized App Store & Google Play review scraper powered by cloakbrowser.",
  "type": "module",
  "bin": {
    "noviq": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "bun run src/cli.ts",
    "scrape": "bun run src/cli.ts",
    "api": "bun run src/api/index.ts",
    "api:dev": "bun run --watch src/api/index.ts",
    "worker": "bun run src/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "type-check": "bunx tsc --noEmit",
    "lint": "bunx biome check",
    "lint:check": "bunx biome check --write",
    "lint:format": "bunx biome format --write",
    "test": "REDIS_URL= bun test test/unit.test.ts test/patterns.test.ts test/errors.test.ts test/concurrency.test.ts test/service.test.ts test/job.test.ts test/job-api.test.ts test/pipeline.test.ts test/api.test.ts",
    "test:redis": "NOVIQ_TEST_REDIS_URL=redis://localhost:6390 REDIS_URL= bun test test/bullmq.test.ts",
    "test:live": "NOVIQ_LIVE=1 bun test test/live.test.ts",
    "docker:build": "docker build -t noviq:latest .",
    "docker:run": "docker run --rm -p 3000:3000 --shm-size=1gb noviq:latest",
    "docker:up": "docker compose up --build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/server-timing": "^1.4.1",
    "@elysiajs/swagger": "^1.3.1",
    "@getworkbench/elysia": "^0.9.1",
    "bullmq": "^5.78.0",
    "cloakbrowser": "^0.3.31",
    "elysia": "^1.4.28",
    "ioredis": "5.10.1",
    "mmdb-lib": "^3.0.2",
    "playwright-core": "^1.53.0",
    "socks-proxy-agent": "^10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@elysiajs/eden": "^1.4.9",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
