{
  "name": "noviq",
  "version": "0.1.0",
  "description": "Humanized App Store & Google Play review scraper powered by cloakbrowser.",
  "type": "module",
  "bin": {
    "noviq": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "bun run src/cli.ts",
    "scrape": "bun run src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "type-check": "bunx tsc --noEmit",
    "lint": "bunx biome check",
    "lint:check": "bunx biome check --write",
    "lint:format": "bunx biome format --write",
    "test": "bun test test/unit.test.ts test/pipeline.test.ts",
    "test:live": "NOVIQ_LIVE=1 bun test test/live.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cloakbrowser": "^0.3.31",
    "playwright-core": "^1.53.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
