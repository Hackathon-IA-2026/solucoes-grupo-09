{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": true, "includes": ["**", "!reference"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 90
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "javascript": {
    "globals": ["Bun"],
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "recommended": true,
        "noUndeclaredVariables": "error",
        "useSingleJsDocAsterisk": "error",
        "noProcessGlobal": "off",
        "noNodejsModules": "off"
      },
      "suspicious": {
        "recommended": true,
        "noEvolvingTypes": "error",
        "noConsole": "off",
        "noEmptyBlockStatements": "off",
        "useAwait": "off",
        "noBitwiseOperators": "off"
      },
      "style": {
        "recommended": true,
        "useBlockStatements": "error",
        "useNumericSeparators": "error",
        "useConsistentArrayType": "error",
        "useConsistentTypeDefinitions": "error",
        "useShorthandAssign": "error",
        "useConsistentCurlyBraces": "error",
        "useDefaultSwitchClause": "error",
        "useExplicitLengthCheck": "error",
        "noMagicNumbers": "off",
        "noJsxLiterals": "off",
        "noProcessEnv": "off",
        "noDefaultExport": "off",
        "useExportsLast": "off",
        "noNestedTernary": "off",
        "useNamingConvention": "off",
        "noParameterProperties": "off",
        "noCommonJs": "off",
        "noImplicitBoolean": "off"
      },
      "complexity": {
        "recommended": true,
        "noExcessiveLinesPerFunction": "off",
        "noExcessiveCognitiveComplexity": "off",
        "useMaxParams": "off",
        "noVoid": "off",
        "useSimplifiedLogicExpression": "error"
      },
      "performance": {
        "recommended": true,
        "useTopLevelRegex": "off",
        "noAwaitInLoops": "off",
        "noReExportAll": "off",
        "noBarrelFile": "off",
        "noNamespaceImport": "off"
      },
      "security": { "recommended": true, "noSecrets": "error" },
      "a11y": { "recommended": true },
      "nursery": "off"
    }
  },
  "overrides": [
    {
      "includes": ["**/doctor.config.json"],
      "json": { "parser": { "allowComments": true, "allowTrailingCommas": true } }
    },
    {
      "includes": ["**/test/**", "**/e2e/**", "**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noMisplacedAssertion": "off" },
          "security": { "noSecrets": "off" }
        }
      }
    }
  ]
}
