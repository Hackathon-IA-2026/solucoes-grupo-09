{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wattsteer.com/schema/llm-gateway-config.schema.json",
  "title": "LlmGatewayConfig",
  "description": "Configuration of the WattSteer model gateway (docs/rag/gateway.yaml): pluggable adapters, limits per provider and per model, a fallback chain per task. The application orchestrates the quotas; a free tier running out is never an error.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "providers", "tasks"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["openai_compatible"]
          },
          "base_url": {
            "type": "string"
          },
          "api_key_env": {
            "type": ["string", "null"],
            "description": "Name of the environment variable holding ONE key. Never the key itself."
          },
          "api_keys_env": {
            "type": ["string", "null"],
            "description": "Name of the variable holding a POOL of comma separated keys (one per team member). Optional: a single key (or api_key_env) behaves the same, a pool of one is the base case. Resolution: api_keys_env, else api_key_env, else the provider is disabled and the chain skips to the next link. Every key has its own counters and cooling; the router picks the key with the most room and only moves to the next provider when every key is spent. Logs show a key only as key_id (first 8 hex of its sha256)."
          },
          "timeout_s": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600,
            "default": 60
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "limits": {
            "$ref": "#/definitions/limits"
          },
          "limits_per_model": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/limits"
            }
          },
          "extra": {
            "type": "object",
            "description": "Provider specific switches the adapter understands, for example thinking_toggle for NVIDIA."
          }
        }
      }
    },
    "tasks": {
      "type": "object",
      "required": ["generate_strong", "embed", "parse"],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chain"],
        "properties": {
          "chain": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider"],
              "properties": {
                "provider": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "max_input_tokens": {
                  "type": "integer",
                  "minimum": 256
                }
              }
            }
          },
          "model": {
            "type": "string",
            "description": "For embed: the only model allowed in the whole chain (one vector space). Every embed link must name the same model."
          },
          "dimensions": {
            "type": "integer",
            "minimum": 64
          },
          "batch_size": {
            "type": "integer",
            "minimum": 1
          },
          "require": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "json_schema": {
                "type": "boolean"
              }
            }
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "max_output_tokens": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "definitions": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rpm": {
          "type": "integer",
          "minimum": 1,
          "description": "requests per minute"
        },
        "tpm": {
          "type": "integer",
          "minimum": 1,
          "description": "tokens (input + output) per minute"
        },
        "rpd": {
          "type": "integer",
          "minimum": 1,
          "description": "requests per day"
        },
        "tpd": {
          "type": "integer",
          "minimum": 1,
          "description": "tokens per day"
        }
      }
    }
  }
}
