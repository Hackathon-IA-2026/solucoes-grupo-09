{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wattsteer.com/schema/rag-evidence.schema.json",
  "title": "RagEvidence",
  "description": "Documentary evidence retrieved from the public ONS/ANEEL record for one subsystem and one date. The service finds, quotes and cites; it never classifies. Every claim carries at least one citation whose quote exists literally in the indexed chunk. Becomes the `documentary_evidence` field of the alert.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subsystem",
    "target_date",
    "gate_at",
    "verdict",
    "items",
    "corpus_version",
    "generated_at",
    "trace"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "subsystem": {
      "type": "string",
      "enum": ["N", "NE", "SE", "S"]
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "Day D of the alert (D-1 is the run)."
    },
    "gate_at": {
      "type": "string",
      "format": "date-time",
      "description": "Cut-off instant: only documents with published_at <= gate_at are eligible, the same discipline as the model's gate_at."
    },
    "question": {
      "type": "string",
      "maxLength": 600,
      "description": "The question actually sent to retrieval."
    },
    "verdict": {
      "type": "string",
      "enum": ["found", "insufficient", "not_found"],
      "description": "found = at least one claim with a valid citation; insufficient = passages existed but no claim passed the gates; not_found = nothing applicable, see reason."
    },
    "reason": {
      "type": ["string", "null"],
      "enum": [
        "no_public_intervention_schedule",
        "corpus_no_coverage_for_date",
        "gates_rejected_all_claims",
        "quota_exhausted_before_answer",
        "quota_exhausted_partial",
        "rag_not_configured",
        null
      ],
      "description": "Required when verdict != found."
    },
    "items": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "supports", "confidence", "evidence_weight", "citations"],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 10,
            "maxLength": 400,
            "description": "A statement in the operator's language: 'the document records', never 'caused'. Every number must appear in one of the citation quotes."
          },
          "supports": {
            "type": "string",
            "enum": ["REL", "CNF", "ENE", "NONE"],
            "description": "Which reason the evidence supports. Information for the rule, not a decision."
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "REL without a public intervention schedule never exceeds medium."
          },
          "evidence_weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Display weight (REL 0.7-0.9; CNF 0.4-0.6; ENE 0.2-0.4). Never an input to the classifier."
          },
          "period": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "string",
                "format": "date-time"
              },
              "end": {
                "type": "string",
                "format": "date-time"
              }
            },
            "description": "The window the document covers, when it can be extracted (used to break ties by duration)."
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "document_id",
                "source",
                "title",
                "published_at",
                "locator",
                "quote",
                "url",
                "sha256"
              ],
              "properties": {
                "document_id": {
                  "type": "string"
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "BDO",
                    "IPDO",
                    "RAP",
                    "PROCEDIMENTOS_REDE",
                    "INSTRUCAO_OPERACAO",
                    "NORMA",
                    "ONS_DADOS_ABERTOS",
                    "SIGA"
                  ]
                },
                "title": {
                  "type": "string",
                  "maxLength": 200
                },
                "published_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "locator": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "page": {
                      "type": ["integer", "null"],
                      "minimum": 1
                    },
                    "section": {
                      "type": ["string", "null"],
                      "maxLength": 120,
                      "description": "For example '§7.1' or 'Submódulo 4.2 item 5.3'."
                    },
                    "table": {
                      "type": ["string", "null"],
                      "maxLength": 120,
                      "description": "For example 'BDO 12_MotivoDespachoTermico' for a BDO table."
                    },
                    "row": {
                      "type": ["integer", "null"],
                      "minimum": 0
                    },
                    "bbox": {
                      "type": ["object", "null"],
                      "description": "Normalised coordinates of the block on the page, when the parser returns them."
                    },
                    "kind": {
                      "type": ["string", "null"]
                    }
                  },
                  "description": "At least one of page, section or table must be non-null (enforced by the gate)."
                },
                "quote": {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 600,
                  "description": "Literal span of the chunk, whitespace collapsed. Gate 1: it must exist in the indexed chunk."
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "sha256 of the raw document, so a replay reproduces the same evidence."
                },
                "chunk_id": {
                  "type": ["string", "null"]
                },
                "external_id": {
                  "type": ["string", "null"],
                  "description": "Document code, for example IO-ON.NE.2SO."
                },
                "revision": {
                  "type": ["string", "null"],
                  "description": "Published revision, for example Rev.146."
                },
                "assembled": {
                  "type": "boolean",
                  "default": false,
                  "description": "true when the quote was assembled from cells of the same table, in order, with cells in between skipped. Prose requires a contiguous span."
                }
              }
            }
          }
        }
      }
    },
    "rule_disagreement": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "rule_cause": {
          "type": "string",
          "enum": ["REL", "CNF", "ENE", "NA"]
        },
        "evidence_cause": {
          "type": "string",
          "enum": ["REL", "CNF", "ENE", "NONE"]
        },
        "note": {
          "type": "string",
          "maxLength": 300
        }
      },
      "description": "Filled by the decision engine when the evidence contradicts the rule: both are published and the disagreement is declared; the classification still comes from the rule and SHAP."
    },
    "numbers_whitelist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Every number present in the citations, plus the numbers the ONS record itself stated (the narration's number gate)."
    },
    "corpus_version": {
      "type": "string",
      "description": "Identifier of the corpus snapshot (date + document count + manifest hash)."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id", "retrieval", "generation"],
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hybrid_candidates", "reranked", "rerank_provider"],
          "properties": {
            "hybrid_candidates": {
              "type": "integer",
              "minimum": 0
            },
            "reranked": {
              "type": "integer",
              "minimum": 0
            },
            "rerank_provider": {
              "type": ["string", "null"],
              "description": "null when no reranker ran."
            },
            "filters": {
              "type": "object"
            },
            "candidates": {
              "type": "array",
              "description": "Every candidate with both ranks and the fused score. This is what makes a bad answer debuggable.",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "attempts", "source"],
          "properties": {
            "provider": {
              "type": ["string", "null"]
            },
            "model": {
              "type": ["string", "null"]
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "source": {
              "type": "string",
              "enum": ["model", "template", "none"]
            },
            "gate_failures": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "quote_not_in_chunk",
                  "number_not_in_quote",
                  "causal_vocabulary",
                  "schema_invalid",
                  "locator_missing",
                  "quote_without_substance",
                  "citation_not_the_named_document",
                  "citation_from_another_event"
                ]
              }
            },
            "rejected": {
              "type": "array",
              "description": "What the model tried to claim, and which gate refused it.",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "retry_at": {
          "type": ["number", "null"],
          "description": "The instant the work can resume, when the quota ran out."
        }
      }
    },
    "sha256": {
      "type": "string",
      "description": "Hash of the published document."
    }
  }
}
