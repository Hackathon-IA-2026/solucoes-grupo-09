# WattSteer — every variable the project needs to run whole.
#
# Copy to `.env` and fill it in. `.gitignore` covers `.env` and `.env.*`, with
# one exception for this file.
#
# **Which file is read, by what.** `docker compose up` passes this root `.env`
# to api, worker, ml and rag (`env_file: .env`, optional). Running a service
# natively instead — `bun run api`, `bun run worker` — reads `apps/api/.env`,
# because Bun loads the .env of the working directory; `apps/api/.env.example`
# is that file's own example and is a subset of this one.
#
# Nothing here is required to run the test suites. `bun run check` passes with
# no .env at all: the database-backed suite skips itself without a URL, and that
# is deliberate.

# --- infrastructure ---------------------------------------------------------
# Postgres. Unset → persistence is disabled and the gateway says so on /ready
# rather than pretending. The port is docker-compose's, not 5432, so a local
# Postgres you already run is not shadowed.
DATABASE_URL=postgres://wattsteer:wattsteer@localhost:5434/wattsteer
# Redis. Set → jobs run on a durable BullMQ queue (multi-worker, restart-safe).
# Unset → an in-process runner, which is fine for development.
REDIS_URL=redis://localhost:6379
# The modelling service. Unset → every schedule that needs it is skipped
# loudly, and the incumbent artifact goes on serving with no new decision line.
WATTSTEER_ML_URL=http://localhost:8000
# The evidence corpus. Unset → the RAG refresh is skipped, same rule.
WATTSTEER_RAG_URL=http://localhost:8082
NODE_ENV=development
PORT=3000

# --- the gateway ------------------------------------------------------------
# all (API + embedded worker) | api (enqueue only) | worker.
WATTSTEER_ROLE=all
# Browser origins allowed by CORS in production, comma-separated. The deployed
# web app's origin MUST be listed or its calls fail preflight. Ignored in
# development, where every origin is allowed.
WATTSTEER_CORS_ORIGINS=https://wattsteer.com,https://www.wattsteer.com
# Per-client requests per window on the metered surface. 0 disables.
WATTSTEER_RATE_LIMIT=60
WATTSTEER_RATE_WINDOW_MS=60000
# Which header the edge puts the real client IP in. Wrong value → every client
# shares one rate-limit bucket, or each forges its own.
WATTSTEER_EDGE_CLIENT_IP_HEADER=x-forwarded-for
# Mounts the BullMQ dashboard at /jobs (needs REDIS_URL). It exposes queue data
# and controls: only behind your own auth.
WATTSTEER_DASHBOARD=false

# --- the worker -------------------------------------------------------------
WATTSTEER_JOB_CONCURRENCY=2
# The weekly retrain, in UTC. `10 3 * * 5` is Fridays 03:10 — so a retrain fix
# waits up to a week for its own proof.
WATTSTEER_RETRAIN_PATTERN=10 3 * * 5
# Set to `off` to skip registering the three refresh sweeps locally.
# WATTSTEER_REFRESH=off

# --- raw-payload custody ----------------------------------------------------
# Production is an S3-compatible bucket. A Railway bucket injects BUCKET /
# ACCESS_KEY_ID / SECRET_ACCESS_KEY / ENDPOINT / REGION, which are read as
# fallbacks, so these five are only needed to override them.
WATTSTEER_ARCHIVE_BUCKET=
WATTSTEER_ARCHIVE_ACCESS_KEY_ID=
WATTSTEER_ARCHIVE_SECRET_ACCESS_KEY=
WATTSTEER_ARCHIVE_ENDPOINT=
WATTSTEER_ARCHIVE_REGION=auto
# Days a payload that produced no revision is kept. Productive ones are kept
# indefinitely.
WATTSTEER_ARCHIVE_RETENTION_DAYS=90
# A directory archive instead, for local work with no bucket.
# WATTSTEER_ARCHIVE_DIR=./.archive

# --- the voice copilot ------------------------------------------------------
# xAI realtime. Without it the dock is **absent rather than broken**: /v1/meta
# reports `voice.configured: false` and the control never renders, so nobody
# presses a button that spends a rate-limit token to stay dead.
XAI_API_KEY=

# --- the evidence corpus (apps/rag) -----------------------------------------
# At least one provider key is required to build or query the corpus. Both are
# free and neither asks for a card:
#   NVIDIA  https://build.nvidia.com     sign in, "Get API Key"
#   Groq    https://console.groq.com     "API Keys"
# Plural because every member of the team can add their own, comma-separated,
# and the gateway treats each as its own quota: it uses the key with the most
# room and only moves to the next provider when they are all spent.
NVIDIA_API_KEYS=
GROQ_API_KEYS=
# Its own database, because pgvector is not in the images the gateway uses and
# apps/api owns every table in `public`.
WATTSTEER_RAG_DATABASE_URL=postgres://wattsteer:wattsteer@localhost:5439/wattsteer_rag
# The bearer the gateway presents to the corpus. Both sides must agree.
WATTSTEER_RAG_ACCESS_TOKEN=
WATTSTEER_RAG_STORE_DIR=.rag-store
WATTSTEER_RAG_MIGRATE_ON_BOOT=1
# Building the corpus on boot is a long crawl over the ONS archive. Leave it off
# locally unless that is the thing you are working on.
WATTSTEER_RAG_INDEX_ON_BOOT=0
# WATTSTEER_RAG_GATEWAY_CONFIG=docs/rag/gateway.yaml
# WATTSTEER_RAG_PORT=8082

# --- the web app ------------------------------------------------------------
# `EXPO_PUBLIC_*` are inlined into the bundle at export time and are therefore
# public by construction. Never put a secret behind this prefix.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SITE_URL=http://localhost:4321
# Cesium ion, for the 3D globe. Without it `cesiumAvailable()` is false, the
# map stays flat and the 2D/3D control explains why — the globe is a layer, not
# a requirement. Free account at https://ion.cesium.com.
EXPO_PUBLIC_CESIUM_ION_TOKEN=

# --- the modelling service (apps/ml) ----------------------------------------
# Read with the `WATTSTEER_ML_` prefix by pydantic settings. All optional.
# WATTSTEER_ML_ENV=development
# WATTSTEER_ML_ARTIFACT_DIR=/data/models   # the volume artifacts are written to
# WATTSTEER_ML_MILP_BACKEND=SCIP
# WATTSTEER_ML_MILP_TIME_LIMIT_MS=2000

# --- tests ------------------------------------------------------------------
# Set by `bun run --cwd apps/api test:db` / `test:redis` to point the
# database-backed suites at a throwaway server. Unset → those suites skip, which
# is why the default `bun run check` needs no infrastructure.
# WATTSTEER_TEST_DATABASE_URL=
# WATTSTEER_TEST_REDIS_URL=
