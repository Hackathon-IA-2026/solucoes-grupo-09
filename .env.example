# Repository root environment, read by docker compose and by apps/rag.
# Copy to .env (git ignores it) and fill in what you need.
#
# Service specific variables live next to their service: apps/api/.env.example.

# --- Model providers -------------------------------------------------------
# At least one key is required to build or query the evidence corpus. Both are
# free and neither asks for a card:
#   NVIDIA  https://build.nvidia.com     sign in, "Get API Key"
#   Groq    https://console.groq.com     "API Keys"
#
# The names are plural because every member of the team can add their own key,
# separated by commas, and the gateway treats each one as its own quota: it uses
# the key with the most room and only moves to the next provider when they are
# all spent. One key alone behaves exactly the same, just with less headroom.
NVIDIA_API_KEYS=
GROQ_API_KEYS=

# --- apps/rag --------------------------------------------------------------
# Its own database, because pgvector is not in the images the gateway uses and
# apps/api owns every table in `public`.
WATTSTEER_RAG_DATABASE_URL=postgres://wattsteer:wattsteer@localhost:5439/wattsteer_rag
# WATTSTEER_RAG_STORE_DIR=.rag-store
# WATTSTEER_RAG_GATEWAY_CONFIG=docs/rag/gateway.yaml
# WATTSTEER_RAG_PORT=8082
# WATTSTEER_RAG_INDEX_ON_BOOT=1     # build the corpus when the container starts
